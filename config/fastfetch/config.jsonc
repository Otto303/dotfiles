{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "arch2",
        "color": {
            "1": "magenta",
            "2": "magenta"
        }
    },
    "display": {
        "separator": "   ",
        "color": "red"
    },
    "modules": [
        {
            "type": "custom", // HardwareStart
            "format": "\u001b[0;31m╭─────────── Hardware Information ───────────╮\u001b[0m"
        },
        {
            "type": "host",
            "key": "  󰌢"
        },
        {
            "type": "cpu",
            "key": "  ",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "detectionMethod": "pci",
            "key": "  ",
            "format": "{name}"
        },
        {
            "type": "display",
            "key": "  󰹑"
        },
        {
            "type": "memory",
            "key": "  "
        },
        {
            "type": "disk",
            "key": "  ",
            "folders": "/"
        },
        {
            "type": "swap",
            "key": "  󰾶"
        },
        {
            "type": "custom", // SoftwareStart
            "format": "\u001b[0;31m╰────────────────────────────────────────────╯\u001b[0m"
        },
        {
            "type": "custom", // SoftwareStart
            "format": "\u001b[0;34m╭─────────── Software Information ───────────╮\u001b[0m"
        },
        {
            "type": "os",
            "key": "  󰣇",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": "  ",
            "keyColor": "blue",
            "format": "{1} {2}"
        },
        {
            "type": "packages",
            "key": "  ",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "  ",
            "keyColor": "blue"
        },
        {
            "type": "shell",
            "key": "  ",
            "keyColor": "blue"
        },
        {
            "type": "custom", // SoftwareStart
            "format": "\u001b[0;34m╰────────────────────────────────────────────╯\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[0;32m╭────────────── Uptime / Age ────────────────╮\u001b[0m"
        },
        {
            "type": "command",
            "key": "  OS Age",
            "keyColor": "green",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  Uptime",
            "keyColor": "green"
        },
        {
            "type": "custom", // InformationEnd
            "format": "\u001b[0;32m╰────────────────────────────────────────────╯\u001b[0m"
        },
        {
            "type": "colors",
            "paddingLeft": 10,
            "symbol": "rectangle"
        }
    ]
}
